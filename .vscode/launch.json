{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug iOS (iPhone 15)",
            "request": "launch",
            "type": "dart",
            "deviceId": "ios",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "development"
            ]
        },
        {
            "name": "Release iOS (iPhone 15)",
            "request": "launch",
            "type": "dart",
            "deviceId": "ios",
            "program": "lib/main.dart",
            "flutterMode": "release"
        },
        {
            "name": "Profile iOS (iPhone 15)",
            "request": "launch",
            "type": "dart",
            "deviceId": "ios",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        }
    ]
}